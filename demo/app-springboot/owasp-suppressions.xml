<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        Fichier de suppressions OWASP Dependency Check.
        Ajouter ici les faux-positifs ou CVE acceptées avec leur justification.

        Format :
        <suppress>
            <notes>Justification — accepté le JJ/MM/AAAA par [nom]</notes>
            <cve>CVE-YYYY-XXXXX</cve>
        </suppress>

        Ou par package GAV :
        <suppress>
            <notes>...</notes>
            <gav regex="true">^org\.example:artifact:.*$</gav>
            <cve>CVE-YYYY-XXXXX</cve>
        </suppress>
    -->

    <!-- Exemple : suppression d'un faux positif spring-boot-devtools en dev -->
    <!--
    <suppress>
        <notes>spring-boot-devtools n'est pas embarqué en production (scope: optional)</notes>
        <gav regex="true">^org\.springframework\.boot:spring-boot-devtools:.*$</gav>
        <cve>CVE-YYYY-XXXXX</cve>
    </suppress>
    -->

    <suppress>
        <notes>CVE-2022-31691 concerne "Spring Tools 4 for Eclipse" (extension d'IDE), pas la bibliotheque
               spring-boot-devtools : faux positif de correspondance de nom (CPE). devtools est optionnel et
               exclu par defaut du jar executable deploye. Accepte le 2026-11-12, a reevaluer a chaque mise a jour.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/spring-boot-devtools@.*$</packageUrl>
        <cve>CVE-2022-31691</cve>
    </suppress>

    <suppress>
        <notes>CVE-2025-7962 decrit une injection SMTP dans Jakarta Mail ; angus-activation (Jakarta Activation)
               est un autre composant. 2.0.3 est la derniere version publiee, aucun correctif disponible.
               Faux positif probable. Accepte le 2026-11-12, a reevaluer a chaque mise a jour.</notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/angus-activation@.*$</packageUrl>
        <cve>CVE-2025-7962</cve>
    </suppress>

</suppressions>
